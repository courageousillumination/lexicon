# Optional: Docker Compose (see docker-compose.yml).
# For Vercel API: set these in the Vercel project env instead (Root Directory: apps/api).

NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Web (Vite) — also set VITE_API_URL to your Vercel API URL when hosting web separately
VITE_APP_NAME=Lexicon
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# VITE_API_URL=https://your-api.vercel.app

# API secrets (Vercel / Docker runtime)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
OPENROUTER_API_KEY=your-openrouter-api-key
# Optional; defaults to google/gemini-2.5-flash-lite
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
