# Used by docker compose (runtime API secrets + Vite build args).
# Copy to .env on the server before building.

NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Baked into the web build at image build time
VITE_APP_NAME=Lexicon
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Runtime API secrets
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
OPENROUTER_API_KEY=your-openrouter-api-key
# Optional; defaults to google/gemini-2.5-flash-lite
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
