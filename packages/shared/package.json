{
  "name": "@lexicon/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./model": {
      "types": "./src/model/index.ts",
      "import": "./dist/model/index.js",
      "default": "./dist/model/index.js"
    },
    "./repository": {
      "types": "./src/repository/index.ts",
      "import": "./dist/repository/index.js",
      "default": "./dist/repository/index.js"
    },
    "./service": {
      "types": "./src/service/index.ts",
      "import": "./dist/service/index.js",
      "default": "./dist/service/index.js"
    },
    "./supabase": {
      "types": "./src/supabase/index.ts",
      "import": "./dist/supabase/index.js",
      "default": "./dist/supabase/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
