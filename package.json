{
  "name": "lexicon",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @lexicon/web --filter @lexicon/api run dev",
    "dev:web": "pnpm --filter @lexicon/web dev",
    "dev:api": "pnpm --filter @lexicon/api dev",
    "build": "pnpm --filter @lexicon/shared build && pnpm -r --filter @lexicon/web --filter @lexicon/api run build",
    "test": "pnpm -r run test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r run typecheck",
    "db:types": "supabase gen types typescript > packages/shared/src/supabase/database.ts && prettier --write packages/shared/src/supabase/database.ts",
    "db:migrate": "supabase migration up",
    "db:migrate:prod": "supabase db push"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "supabase": "^2.111.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
